# Copy to .env for local development. Never commit .env.
# In production these come from Fly secrets (BOT_TOKEN, ALLOWED_USER_IDS) and fly.toml
# (DB_PATH, COVERS_DIR).

# Bot token from @BotFather. Placeholder only; use a separate test bot locally.
BOT_TOKEN=123456789:replace-with-your-bot-token

# Comma-separated Telegram user IDs allowed to use the bot (at least one is required).
ALLOWED_USER_IDS=111111111,222222222

# SQLite database file and the directory for downloaded covers.
DB_PATH=./data/library.db
COVERS_DIR=./data/covers

# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
